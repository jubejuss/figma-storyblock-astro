---
import { storyblokEditable } from '@storyblok/astro';
const { blok, story } = Astro.props;
const c = blok || story?.content;
const date = story?.first_published_at ?? c?.published_at;
---

<header class="article-header" {...(blok ? storyblokEditable(blok) : {})}>
	<h1>{c?.title}</h1>
	<div class="meta">
		<span>{date ? new Date(date).toLocaleDateString('et-EE') : ''}</span>
		{c?.author_name && <><span>·</span><span>{c.author_name}</span></>}
	</div>
	{
		c?.cover_image?.filename && (
			<img class="cover" src={c.cover_image.filename} alt={c.cover_image.alt || ''} />
		)
	}
</header>

<style>
	.article-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding: var(--space-lg);
		max-width: var(--content-width);
		margin: 0 auto;
		width: 100%;
	}
	h1 {
		font-size: var(--font-size-h1);
		font-weight: 700;
	}
	.meta {
		display: flex;
		gap: var(--space-sm);
		color: var(--color-text-muted);
	}
	.cover {
		aspect-ratio: 16 / 9;
		width: 100%;
		object-fit: cover;
		border-radius: var(--radius-md);
	}
</style>
